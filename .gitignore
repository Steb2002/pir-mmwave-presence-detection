# Ambienti Python
.venv/
venv/
__pycache__/
*.pyc

# File temporanei
*.tmp
~$*

# Materiali generati da analisi/rigenera_tutto.py.
# Sono ricostruibili in ~13 s dai CSV grezzi, e pesano ~8 MB a ogni rigenerazione:
# versionarli gonfierebbe la storia del repo senza aggiungere nulla che i tre
# script non sappiano rifare. I CSV di acquisizione restano tracciati: quelli
# sono l'unico dato che non si puo' ricostruire.
tesi-unicam/figures/fig*.pdf
tesi-unicam/figures/fig*.png
analisi/dati_tesi.xlsx
RIEPILOGO_INCONTRO.html
RIEPILOGO_INCONTRO.pdf
# PDF della tesi compilato in locale (MiKTeX) e catalogo delle figure: si rifanno
tesi-unicam/main.pdf
analisi/CATALOGO_FIGURE.pdf

# Log del tool PC Hi-Link LD2420: rigenerati a ogni avvio, come quelli del LD2410 Tool
HLK-LD2420/HLK-LD2420_TOOL -English/Log/

# cartella di build LaTeX locale (pdflatex -output-directory=B)
tesi-unicam/B/
tesi-unicam/$B/
